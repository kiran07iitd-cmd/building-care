{
  "buildCommand": "npm run build",
  "outputDirectory": ".vercel/output",
  "installCommand": "npm install",
  "framework": null,
  "build": {
    "env": {
      "NITRO_PRESET": "vercel"
    }
  },
  "routes": [
    {
      "src": "/favicon\\.ico",
      "status": 204,
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "continue": false
    },
    {
      "src": "/favicon\\.png",
      "status": 204,
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "continue": false
    }
  ]
}
